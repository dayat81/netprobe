FROM python:3.12-slim
WORKDIR /app
COPY server/requirements.txt server/requirements-gcp.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/requirements-gcp.txt
COPY server /app
ENV PYTHONPATH=/app \
    OSM_BIND=0.0.0.0 \
    OSM_ROLE=flows \
    OSM_STORE=firestore \
    OSM_ALLOWLIST=0.0.0.0/0,::/0 \
    OSM_TRUSTED_PROXIES=0.0.0.0/0,::/0 \
    OSM_KEY_FILE=/secrets/hmac.key
EXPOSE 8080
CMD ["python", "-m", "opensignal_mirror.gcp_entry"]
